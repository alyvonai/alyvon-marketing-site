# PostHog — direct integration for pageviews, CTA events, and funnel analysis.
# Absent key = analytics no-ops (spec §10).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Tag Manager — container for GA4, Google Ads, Meta Pixel, LinkedIn Insight.
# Defaults to the live container (GTM-TB6ZP4SH) in lib/site.ts; set here to override.
NEXT_PUBLIC_GTM_ID=

# Booking URLs (verified GoHighLevel booking/form links). When absent the site falls back
# to a mailto: link (spec §5).
NEXT_PUBLIC_MARKETING_HUB_BOOKING_URL=
NEXT_PUBLIC_ANALYTICS_BOOKING_URL=

# GoHighLevel embed IDs (lead forms, spec §29). Optional — pages render a mailto/booking
# fallback when unset.
NEXT_PUBLIC_GHL_WORKFORCE_FORM_ID=
NEXT_PUBLIC_GHL_MARKETING_HUB_FORM_ID=
NEXT_PUBLIC_GHL_ANALYTICS_FORM_ID=
NEXT_PUBLIC_GHL_BOOKING_CALENDAR_ID=
